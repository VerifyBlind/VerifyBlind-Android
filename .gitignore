# Android SDK path — machine specific, generated by Android Studio
local.properties

# Gradle build outputs and caches
build/
.gradle/
app/build/

# Android Studio IDE
.idea/
*.iml
captures/

# Keystore files — never commit signing keys
*.jks
*.keystore
release/*.jks
release/*.keystore
release.bat

# Log / compile artifacts
build_log.txt
compile_output.txt
*.log

# OS
.DS_Store
Thumbs.db

#Firebase private key
*privatekey.json

# Build-time generated asset (her build'de yeniden uretilir)
app/src/main/assets/build_info.json
# CI'in 1. gecisinde sentry-cli yazar, 2. gecise girdi olur (bkz. build-android.yml).
