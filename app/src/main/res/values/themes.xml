<resources>
    <!-- Base application theme. -->
    <style name="Theme.VerifyBlind" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <!-- Secondary brand color — cyan signature accent -->
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <!-- statusBarColor/navigationBarColor deprecated + ignored since API 35 (edge-to-edge is
             enforced); transparency for API 21-34 now comes from enableEdgeToEdge() in code
             (MainActivity/SplashActivity onCreate), so no theme item is needed here. -->
        <!-- Window background (shown behind status/nav bar on all screens) -->
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    
    <style name="RoundedImageCorner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Canlılık kılavuzu (activity_liveness.xml guideOverlay) -->
    <style name="LivenessGuideBullet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sv_on_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="LivenessGuideMove">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sv_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LivenessGuideMoveHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/sv_on_surface_variant</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>