<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_background">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TOP APP BAR  (Dark — landing header ile aynı tasarım dili) -->
    <!-- Yükseklik/inset WalletFragment.applyWindowInsets() ile      -->
    <!-- durum çubuğunun arkasına uzatılır.                         -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@color/bg_dark"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tam-renkli marka kalkanı (landing header ile aynı logo) -->
        <ImageView
            android:id="@+id/ivTitleIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/logo"
            android:layout_marginEnd="9dp"
            android:contentDescription="VerifyBlind"/>

        <!-- İki-tonlu wordmark: Verify (beyaz) + Blind (blue-400) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blind"
            android:textColor="@color/sv_secondary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"/>

        <!-- BETA rozeti (amber pill) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BETA"
            android:textColor="@color/accent_orange"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginStart="9dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_beta_badge"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/sv_outline_variant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"/>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- BİLDİRİM İZNİ SOFT-ASK (priming) BANNER                 -->
    <!-- Sistem iznini DOĞRUDAN açmaz; "İzin Ver"e basınca tetikler. -->
    <!-- Görünürlük WalletFragment.updateNotifBanner() tarafından yönetilir. -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotifSoftAsk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/sv_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sv_outline_variant"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/theme_primary"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notif_softask_title"
                        android:textColor="@color/sv_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/notif_softask_desc"
                        android:textColor="@color/sv_on_surface_variant"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotifLater"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/notif_softask_later"
                    android:textAllCaps="false"
                    android:textColor="@color/sv_on_surface_variant"
                    android:textSize="14sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotifAllow"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/notif_softask_allow"
                    android:textAllCaps="false"
                    android:textColor="@color/sv_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/theme_primary"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- CONTENT AREA                                           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardNotifSoftAsk"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ─────────────────────────────────────────────────── -->
        <!-- EMPTY STATE                                         -->
        <!-- ─────────────────────────────────────────────────── -->
        <!-- Kaydırılabilir: dikey alan yetmediğinde (yatay, bölünmüş ekran,
             büyütülmüş yazı tipi) içerik yok olmak yerine kayar. fillViewport
             sayesinde alan yettiğinde çocuk viewport'a gerilir ve zincirin
             bias'ı bugünküyle aynı çalışır. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutEmptyStateContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ╔═════════════════════════════════════════════╗ -->
            <!-- ║  ILLUSTRATION AREA                          ║ -->
            <!-- ╚═════════════════════════════════════════════╝ -->
            <FrameLayout
                android:id="@+id/illustrationContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_percent="0.82"
                app:layout_constraintWidth_max="340dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvEmptyTitle"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.36">

                <!-- Soft background glow circle -->
                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_blur_circle"
                    android:alpha="0.6"/>

                <!-- Outer NFC ring (animated in WalletFragment via ObjectAnimator) -->
                <View
                    android:id="@+id/nfcRingOuter"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nfc_ring_blue"
                    android:alpha="0.28"/>

                <!-- Inner NFC ring -->
                <View
                    android:id="@+id/nfcRingInner"
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nfc_ring_blue"
                    android:alpha="0.18"/>

                <!-- ══ White ID Card Mockup (tilted -6°) ══ -->
                <FrameLayout
                    android:id="@+id/emptyCard"
                    android:layout_width="192dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:translationX="18dp"
                    android:translationY="-30dp"
                    android:rotation="-6"
                    android:background="@drawable/bg_card_mockup"
                    android:elevation="4dp"
                    android:padding="14dp">

                    <!-- Fingerprint icon circle (top-left of card) -->
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="top|start"
                        android:background="@drawable/bg_fingerprint_circle">

                        <ImageView
                            android:id="@+id/ivEmptyIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_fingerprint"
                            app:tint="@color/sv_secondary_container"/>
                    </FrameLayout>

                    <!-- Placeholder data lines (bottom of card) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginEnd="60dp"
                            android:background="@color/sv_surface_highest"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="88dp"
                            android:background="@color/sv_surface_high"/>
                    </LinearLayout>

                </FrameLayout>

                <!-- ══ Phone Mockup (dark navy, front-center) ══ -->
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="182dp"
                    android:layout_gravity="center"
                    android:translationY="8dp"
                    android:background="@drawable/bg_phone_mockup_new"
                    android:elevation="8dp">

                    <!-- Notch pill -->
                    <View
                        android:layout_width="36dp"
                        android:layout_height="5dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_phone_notch"
                        android:alpha="0.5"/>

                    <!-- Contactless / NFC tap icon -->
                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nfc_waves"
                        app:tint="@color/sv_secondary_container"/>

                    <!-- Home indicator ring -->
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_phone_home_button"/>

                </FrameLayout>

            </FrameLayout>

            <!-- ══ Empty-state Title ══ -->
            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:text="@string/empty_state_title"
                android:textColor="@color/sv_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                app:layout_constraintTop_toBottomOf="@id/illustrationContainer"
                app:layout_constraintBottom_toTopOf="@id/tvEmptyDesc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ══ Empty-state Description ══ -->
            <TextView
                android:id="@+id/tvEmptyDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:text="@string/empty_state_desc"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/tvEmptyTitle"
                app:layout_constraintBottom_toTopOf="@id/btnAddId"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ══ Primary CTA: Kimlik Kartı Ekle ══ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddId"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_add_id"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/sv_on_primary"
                android:background="@drawable/bg_vault_button"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_add_card"
                app:iconTint="@color/sv_on_primary"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconPadding="10dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvEmptyDesc"
                app:layout_constraintBottom_toTopOf="@id/btnDemoMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ══ Demo CTA: Demo Modu (sadece demoEnabled=true'da görünür) ══ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDemoMode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="8dp"
                android:text="@string/demo_mode_title"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sv_secondary"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/sv_secondary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="16dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/btnHowItWorks"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ══ Secondary link: Nasıl Çalışır? ══ -->
            <LinearLayout
                android:id="@+id/btnHowItWorks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginBottom="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_help"
                    app:tint="@color/sv_secondary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/link_how_it_works"
                    android:textColor="@color/sv_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- Hidden legacy IDs (referenced by Fragment code) -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="MissingConstraints"/>
            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="MissingConstraints"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- ─────────────────────────────────────────────────── -->
        <!-- REGISTERED STATE (ACTIVE)                           -->
        <!-- ─────────────────────────────────────────────────── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutRegisteredState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_wallet_body"
            android:visibility="gone">

            <!-- Card — 100px (~76dp) more from top than default -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/cardViewPager"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="92dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Transparent overlay to capture card tap -->
            <View
                android:id="@+id/cardTapOverlay"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="92dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="12dp"
                app:tabRippleColor="@null"
                android:background="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/cardViewPager"
                android:visibility="gone"/>

            <!-- QR button — pinned to bottom -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_qr_login"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/sv_on_primary"
                android:background="@drawable/bg_vault_button"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:icon="@drawable/bg_qr_scan"
                app:iconGravity="textStart"
                app:iconTint="@color/sv_on_primary"
                app:iconSize="20dp"
                app:iconPadding="12dp"
                app:layout_constraintBottom_toTopOf="@id/btnDeleteText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Delete link — pinned to bottom -->
            <LinearLayout
                android:id="@+id/btnDeleteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:padding="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/error"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_delete_identity"
                    android:textColor="@color/error"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
