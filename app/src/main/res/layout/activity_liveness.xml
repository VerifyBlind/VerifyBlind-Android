<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubInstruction"
        app:layout_constraintBottom_toTopOf="@+id/tvBottomHint" />

    <com.verifyblind.mobile.view.FaceFrameOverlayView
        android:id="@+id/faceFrameOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@+id/viewFinder"
        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
        app:layout_constraintTop_toTopOf="@+id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@+id/viewFinder" />

    <TextView
        android:id="@+id/tvStepCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/black"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTopHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="24dp"
        android:text="@string/liveness_top_hint"
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStepCounter" />


    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="@string/liveness_preparing"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTopHint" />

    <TextView
        android:id="@+id/tvSubInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text=""
        android:textColor="#333333"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/tvInstruction"
        app:layout_constraintStart_toStartOf="@+id/tvInstruction"
        app:layout_constraintTop_toBottomOf="@+id/tvInstruction" />

    <!-- Anlık ortam kalitesi uyarısı (ışık) — varsayılan gizli, kötü koşulda kırmızı görünür -->
    <TextView
        android:id="@+id/tvQualityWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text=""
        android:visibility="gone"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#CCEE3B3B"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/viewFinder" />

    <TextView
        android:id="@+id/tvBottomHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        android:text=""
        android:textColor="#555555"
        android:textSize="13sp"
        android:gravity="center"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/layoutLiveStatus"/>

    <!-- Real-time Status Overlay -->
    <LinearLayout
        android:id="@+id/layoutLiveStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#80FFFFFF"
        android:padding="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLiveChipPhoto"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            app:shapeAppearanceOverlay="@style/RoundedImageCorner"/>

        <TextView
            android:id="@+id/tvLiveScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- KILAVUZ — akış başlamadan önce bir kez. Her şeyin ÜSTÜNDE (son çocuk + yükselti):
         kamera arkada ısınırken kullanıcı ne yapacağını okur. Yanlış reddin en ucuz ilacı baştan
         doğru bilgi; hareketlerin nasıl yapılacağı komut ekrana gelince de alt satırda yazıyor. -->
    <ScrollView
        android:id="@+id/guideOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sv_background"
        android:clickable="true"
        android:elevation="8dp"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/liveness_guide_title"
                android:textColor="@color/sv_on_surface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/liveness_guide_subtitle"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/sv_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sv_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/LivenessGuideBullet"
                        android:text="@string/liveness_guide_light" />

                    <TextView
                        style="@style/LivenessGuideBullet"
                        android:layout_marginTop="12dp"
                        android:text="@string/liveness_guide_hold" />

                    <TextView
                        style="@style/LivenessGuideBullet"
                        android:layout_marginTop="12dp"
                        android:text="@string/liveness_guide_accessories" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvGuideMovesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/sv_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/liveness_guide_moves_intro"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sv_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sv_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/LivenessGuideMove"
                        android:text="@string/liveness_face_blink" />

                    <TextView
                        style="@style/LivenessGuideMoveHint"
                        android:text="@string/liveness_ev_hint_blink" />

                    <TextView
                        style="@style/LivenessGuideMove"
                        android:layout_marginTop="14dp"
                        android:text="@string/liveness_face_double_blink" />

                    <TextView
                        style="@style/LivenessGuideMoveHint"
                        android:text="@string/liveness_ev_hint_double_blink" />

                    <TextView
                        style="@style/LivenessGuideMove"
                        android:layout_marginTop="14dp"
                        android:text="@string/liveness_face_smile" />

                    <TextView
                        style="@style/LivenessGuideMoveHint"
                        android:text="@string/liveness_ev_hint_smile" />

                    <TextView
                        style="@style/LivenessGuideMove"
                        android:layout_marginTop="14dp"
                        android:text="@string/liveness_face_mouth_open" />

                    <TextView
                        style="@style/LivenessGuideMoveHint"
                        android:text="@string/liveness_ev_hint_mouth_open" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuideStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:padding="14dp"
                android:text="@string/liveness_guide_start"
                android:textColor="@color/sv_on_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sv_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
