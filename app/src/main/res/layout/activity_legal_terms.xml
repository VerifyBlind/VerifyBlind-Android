<?xml version="1.0" encoding="utf-8"?>
<!--
  Hukuki metin kabul kapısı. Tam ekran ve geri tuşuna kapalıdır: kabul edilmeden uygulama
  kullanılamaz (clickwrap). Onay kutusu işaretlenmeden "Kabul et" butonu etkinleşmez.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_background"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/scrollLegal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLegalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legal_terms_title"
                android:textColor="@color/sv_on_surface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLegalIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/legal_terms_intro"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- Kısa özet: kullanıcı metinleri açmadan da temel yükümlülükleri görür. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/legal_terms_summary_title"
                android:textColor="@color/sv_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/legal_terms_summary_body"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp" />

            <!-- Metinlerin tamamına giden bağlantılar -->
            <TextView
                android:id="@+id/tvLinkTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingVertical="8dp"
                android:text="@string/legal_terms_link_terms"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvLinkDpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="@string/legal_terms_link_dpa"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvLinkDisclosure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="@string/legal_terms_link_disclosure"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvLegalVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/sv_surface"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <CheckBox
            android:id="@+id/cbLegalAccept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/legal_terms_checkbox"
            android:textColor="@color/sv_on_surface"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLegalAccept"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/legal_terms_accept"
            android:textSize="15sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLegalDecline"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/legal_terms_decline"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
