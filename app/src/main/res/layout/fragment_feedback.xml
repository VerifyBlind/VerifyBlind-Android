<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_background"
    android:fitsSystemWindows="true">

    <!-- ════ TOP APP BAR ════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_right"
            android:rotation="180"
            app:tint="@color/sv_on_surface_variant"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/btn_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_title"
            android:textColor="@color/sv_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_intro"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp" />

            <!-- İsim -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_name_label"
                android:textColor="@color/sv_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:padding="14dp"
                android:hint="@string/feedback_name_hint"
                android:textColorHint="@color/sv_on_surface_variant"
                android:textColor="@color/sv_on_surface"
                android:textSize="14sp"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="120"
                android:maxLines="1"
                android:autofillHints="name"
                android:layout_marginBottom="14dp" />

            <!-- E-posta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_email_label"
                android:textColor="@color/sv_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:padding="14dp"
                android:hint="@string/feedback_email_hint"
                android:textColorHint="@color/sv_on_surface_variant"
                android:textColor="@color/sv_on_surface"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:maxLength="256"
                android:maxLines="1"
                android:autofillHints="emailAddress"
                android:layout_marginBottom="14dp" />

            <!-- Konu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_subject_label"
                android:textColor="@color/sv_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:padding="14dp"
                android:hint="@string/feedback_subject_hint"
                android:textColorHint="@color/sv_on_surface_variant"
                android:textColor="@color/sv_on_surface"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:maxLength="160"
                android:maxLines="2"
                android:layout_marginBottom="14dp" />

            <!-- Mesaj -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_message_label"
                android:textColor="@color/sv_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:padding="14dp"
                android:hint="@string/feedback_message_hint"
                android:textColorHint="@color/sv_on_surface_variant"
                android:textColor="@color/sv_on_surface"
                android:textSize="14sp"
                android:gravity="top"
                android:minLines="5"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:maxLength="4000"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/feedback_submit"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/accent_blue" />

            <ProgressBar
                android:id="@+id/pbSubmit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_privacy_note"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="11sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
